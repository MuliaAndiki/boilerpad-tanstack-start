# Copy to `.env` / `.env.local` for local overrides (gitignored).
# Mode-specific files (.env.development, .env.staging, .env.production) are
# committed and must only contain PUBLIC values: anything prefixed with VITE_
# is bundled into client code. NEVER put secrets here.

VITE_APP_NAME=Boilerpad
VITE_APP_ENV=development
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com

# Server-only secrets: use `.dev.vars` locally (gitignored) and
# `wrangler secret put <NAME> --env <staging|production>` when deployed.
